{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Cody-Sims/Vistara/blob/main/.shadow/schema.json",
  "title": "Vistara Shadow decision",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "id",
    "title",
    "status",
    "date",
    "statement",
    "rationale",
    "owners",
    "anchors",
    "evidence",
    "relations"
  ],
  "properties": {
    "$schema": {
      "const": "../schema.json"
    },
    "id": {
      "type": "string",
      "pattern": "^DEC-[0-9]{4}$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "accepted",
        "observed",
        "proposed",
        "superseded"
      ]
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "statement": {
      "type": "string",
      "minLength": 1
    },
    "rationale": {
      "type": "string",
      "minLength": 1
    },
    "owners": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "anchors": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/reference"
      }
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/reference"
      }
    },
    "relations": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/relation"
      }
    }
  },
  "$defs": {
    "reference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "locator"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "locator": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "relation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "target"
      ],
      "properties": {
        "type": {
          "enum": [
            "constrains",
            "depends_on",
            "superseded_by",
            "supersedes",
            "supports"
          ]
        },
        "target": {
          "type": "string",
          "pattern": "^DEC-[0-9]{4}$"
        }
      }
    }
  }
}
