{
  "name": "vistara-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:pages": "tsc --noEmit && vite build --mode pages && node scripts/create-pages-fallback.mjs",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit --pretty false",
    "test": "vitest",
    "api:generate": "node scripts/gallery-api.mjs generate",
    "api:check": "node scripts/gallery-api.mjs check && node --test scripts/gallery-api.node.mjs",
    "brand:generate": "node scripts/write-brand-assets.mjs",
    "check": "npm run api:check && npm run lint && npm run typecheck && npm run test -- --run && npm run build"
  },
  "dependencies": {
    "@tanstack/react-query": "5.104.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router-dom": "7.18.4"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@readme/openapi-parser": "9.1.0",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "10.12.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.13.0",
    "jsdom": "30.1.2",
    "typescript": "7.0.2",
    "typescript-eslint": "8.71.1",
    "vite": "8.3.4",
    "vitest": "5.0.3"
  },
  "engines": {
    "node": "^22.13.0 || >=24.0.0"
  }
}
